# Django Secret Key
DJANGO_SECRET_KEY=your-secret-key-here
cat > .env.example << 'EOF'
# Django Secret Key
DJANGO_SECRET_KEY=your-secret-key-here

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here

# Todoist API Key (optional - for task management)
TODOIST_API_KEY=your-todoist-api-key-here
